# MOLA dependencies this package must build FROM SOURCE, imported by CI into a
# directory beside the workspace (see .github/workflows/build-ros.yml).
#
#   mola_sm_loop_closure -- the loop-closure engine is driven through its
#     detector-only analyze() API (LoopClosureAnalyzeOptions, ProposedLoopEdge),
#     first released in 1.3.0. Drop this entry once 1.3.0 binaries are
#     available in the ROS apt repos.
#
# Cloned OUTSIDE this repo and built via colcon --base-paths. Not into a
# subdirectory: colcon stops descending once a directory is itself a package,
# and this repo's package.xml is at the root, so a nested clone is silently
# never discovered.
repositories:
  mola_sm_loop_closure:
    type: git
    url: https://github.com/MOLAorg/mola_sm_loop_closure.git
    version: develop
